# Salin jadi `.env` lalu isi nilai default untuk build Anda (opsional).
# JANGAN commit `.env` ke repo publik — token akan bocor.

# Token HF role Write (buat di https://huggingface.co/settings/tokens)
VITE_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxx

# Owner HF (auto-dideteksi dari token bila dikosongkan)
VITE_HF_OWNER=

# Nama Space tujuan
VITE_HF_SPACE=cpp2apk
